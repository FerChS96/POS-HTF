# Variables de entorno para POS HTF
# Configuración de Supabase (opcional)
SUPABASE_URL=tu_url_de_supabase_aqui
SUPABASE_KEY=tu_key_de_supabase_aqui

# Configuración de la aplicación
APP_NAME=HTF Gimnasio POS
APP_VERSION=1.0.0

# ============================================================================
# SERVIDOR DE ENTRADAS DEL TORNIQUETE (FastAPI, puerto 8001)
# ============================================================================

# OBLIGATORIO. Token compartido con el torniquete. El torniquete debe enviarlo
# en la cabecera HTTP "X-API-Token" en cada POST /entrada y POST /test-entrada.
# Sin esta variable el servidor entra en MODO DEGRADADO: solo escucha en
# 127.0.0.1 y rechaza cualquier petición de la red (el torniquete NO funciona).
# Genera uno largo y aleatorio, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TORNIQUETE_API_TOKEN=genera_un_token_largo_y_aleatorio_aqui

# OPCIONAL. Lista blanca de IPs de origen, separadas por comas.
# Vacío o sin definir = sin restricción por IP (se confía solo en el token).
# Se recomienda fijar la IP del torniquete en el router y ponerla aquí.
# OJO: la lista NO exime a localhost. Si la activas y no incluyes 127.0.0.1,
# diagnostico_servidor.py (que corre en la misma máquina del POS) recibirá 403.
# TORNIQUETE_IPS_PERMITIDAS=192.168.1.50,127.0.0.1

# OPCIONAL. Interfaz donde escucha el servidor.
# Si no se define: 0.0.0.0 cuando hay token configurado, 127.0.0.1 cuando no.
# Úsala para acotar la escucha a una sola tarjeta de red del POS.
# TORNIQUETE_LISTEN_HOST=192.168.1.10

# ============================================================================
# IMPRESORA DE TICKETS
# ============================================================================

# OPCIONAL. Nombre EXACTO de la impresora tal como aparece en Windows.
# Si no se define, el POS la busca sola: prefiere "Text Only"/"Generic" y
# descarta las virtuales (PDF, XPS, OneNote, Fax).
# Definirla es lo recomendado si hay varias impresoras en la maquina.
# Ojo: el nombre real puede traer caracteres raros, p. ej. "Generic / Text Only :)"
# Para ver los nombres instalados:
#   python -c "import sys;sys.path.insert(0,'.');from services.printing.windows_printer_manager import WindowsPrinterManager as W;print(W.obtener_impresoras_instaladas())"
# TICKET_IMPRESORA=Generic / Text Only :)

# OPCIONAL. Ancho del papel en columnas. Es el mismo valor para la vista previa
# en pantalla y para lo que sale impreso.
#   58 mm -> 32 (por defecto)   |   80 mm -> 48
# TICKET_ANCHO_COLUMNAS=32
