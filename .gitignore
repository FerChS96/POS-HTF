# Credenciales reales. La plantilla .env.example SI se versiona: no lleva
# secretos y documenta que variables hay que configurar.
.env
create_test_user_recepcionista.py
create_users_alexa_balbina.py

# Volcados de la base de produccion para QA. Llevan datos reales de miembros
# y ventas: NUNCA deben versionarse.
qa_dump/
supabase/.temp/

# Logs y base local: se regeneran solos, no deben versionarse
*.log
pos_htf.txt
*.db

# PyInstaller
build/
dist/
build_onefile/
*.spec
# El spec del POS SI se versiona: define como se compila el .exe (que modulos
# se empaquetan, que imports ocultos hacen falta). Sin el, la compilacion no
# es reproducible.
!HTF_Gimnasio_POS.spec
*.exe

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db